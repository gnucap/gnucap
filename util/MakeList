TARGET = ${RAW_SRCS:%.cc=%${TARGET_LIB_EXT}}
TARGET_LIB_EXT = .so
SECTION = util
#------------------------------------------------------------------------
INSTALL_FILES = $(TARGET)
INSTALL_DIR = $(PREFIX)/lib/gnucap/${SECTION}
#------------------------------------------------------------------------
# utility commands, usually one file per command
# some have multiple commands in a file
RAW_SRCS = \
c_clear.cc c_comand.cc c_delete.cc c_exp.cc \
c_global.cc c_ground.cc c_help.cc \
c_list.cc c_measure.cc c_modify.cc c_param.cc c_prbcmd.cc \
c_status.cc c_sweep.cc c_sim.cc c_system.cc

#------------------------------------------------------------------------
RAW_OTHER = MakeList
#------------------------------------------------------------------------
RAW = $(RAW_HDRS) $(RAW_SRCS) $(RAW_OTHER)
#------------------------------------------------------------------------
#------------------------------------------------------------------------
DIST_FILES = $(RAW)
#------------------------------------------------------------------------
#------------------------------------------------------------------------
SRCS = $(RAW_SRCS)
HDRS = $(RAW_HDRS)
# OBJS = ${SRCS:.cc=.o}
TARGET_DEPENDS = $(OBJS) $(RAW)
