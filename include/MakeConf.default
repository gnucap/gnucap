#------------------------------------------------------------------------

MAKE_CXXFLAGS = -fPIC -std=c++11 -O2 -W ${CXXFLAGS}
MAKE_CPPFLAGS = -DUNIX $(INCLUDE) -DNDEBUG -DHAVE_LIBREADLINE ${CPPFLAGS}

.SUFFIXES : .so .o .cc
.cc.o:; $(CXX) $(MAKE_CXXFLAGS) $(CXXFLAGS) ${MAKE_CPPFLAGS} -c $< # configure/Make2
.cc.so:; $(MAKE_LIB) $<
#------------------------------------------------------------------------
MAKE_EXE = $(CXX) $(MAKE_CXXFLAGS) ${MAKE_CPPFLAGS} $(OBJS) $(LIBS) $(LDFLAGS) -o $@ # Make2.default
MAKE_LIB = $(CXX) $(MAKE_CXXFLAGS) ${MAKE_CPPFLAGS} $(OBJS) $(LIBS) $(LDFLAGS) -shared -o $@ # Make2.default
all: $(TARGET_EXE) $(TARGET)
#------------------------------------------------------------------------
#------------------------------------------------------------------------
# build with other Make2 files. (but keep configured settings)
default:
	${MAKE} all PRESET=default # Make2.default
debug:
	${MAKE} all PRESET=Debug # Make2.default
g++:
	${MAKE} all PRESET=g++ # Make2.default
#------------------------------------------------------------------------
#------------------------------------------------------------------------
#------------------------------------------------------------------------
#------------------------------------------------------------------------
#------------------------------------------------------------------------
