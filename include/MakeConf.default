# default preset for Gnucap.
#------------------------------------------------------------------------
# comment out to build witout readline support
HAVE_LIBREADLINE = -DHAVE_LIBREADLINE
LIBREADLINE = -lreadline
#------------------------------------------------------------------------
MAKE_CXXFLAGS = -fPIC -std=c++14 -O2 -W ${LIST_CXXFLAGS} ${CXXFLAGS}
MAKE_CPPFLAGS = -DUNIX $(INCLUDE) -DNDEBUG ${LIST_CPPFLAGS} ${CPPFLAGS}
#------------------------------------------------------------------------
.SUFFIXES : .so .o .cc
.cc.o:; $(CXX) $(MAKE_CXXFLAGS) ${MAKE_CPPFLAGS} -c $< # include/MakeConf.default
.cc.so:; $(MAKE_LIB) $<
#------------------------------------------------------------------------
MAKE_EXE = $(CXX) $(MAKE_CXXFLAGS) ${MAKE_CPPFLAGS} $(OBJS) $(LIBS) $(LDFLAGS) -o $@ # MakeConf.default
MAKE_LIB = $(CXX) $(MAKE_CXXFLAGS) ${MAKE_CPPFLAGS} $(OBJS) $(LIBS) $(LDFLAGS) -shared -o $@ # MakeConf.default
all: $(TARGET_EXE) $(TARGET)
#------------------------------------------------------------------------
#------------------------------------------------------------------------
# build with other Make2 files. (but keep configured settings)
default:
	${MAKE} all PRESET=default # Make2.default
debug:
	${MAKE} all PRESET=Debug # Make2.default
g++:
	${MAKE} all PRESET=g++ # Make2.default
#------------------------------------------------------------------------
#------------------------------------------------------------------------
#------------------------------------------------------------------------
#------------------------------------------------------------------------
#------------------------------------------------------------------------
