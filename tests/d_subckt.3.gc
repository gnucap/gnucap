// like d_subckt.1.ckt, but zzz is a module
spice
V1   2  0  1.
X1   2  1  3 zzz
X2   2  4  5 zzz

.verilog
module zzz (.\1 (\1 ),.\2 (\2 ),.\4 (\4 ));
  ground \0 ;
  resistor #(.r( 1.)) R1 (.p(\1 ),.n(\2 ));
  resistor #(.r( 1.)) R2 (.p(\2 ),.n(\0 ));
  resistor #(.r( 1.)) R3 (.p(\2 ),.n(\3 ));
  resistor #(.r( 1.)) R4 (.p(\3 ),.n(\0 ));
  resistor #(.r( 1.)) r5 (.p(\3 ),.n(\4 ));
  resistor #(.r( 1.)) r6 (.p(\4 ),.n(\0 ));
endmodule // zzz

spice

.width out=160
.print op v(nodes)
.op
.print op + v(r1.x1) v(r?.x1) v(r2.x?)
.op
.print
.list
*>.status notime
.end
