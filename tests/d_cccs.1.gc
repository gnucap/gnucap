# cccs test, with element probes (forces full eval)
spice
i1 1 0 dc 11 ac 11
.verilog
//isource #( DC  11.  AC  11.) i1 (.p(\1 ),.n(\0 ));
resistor #(.r( 10.)) ri1 (.p(\1 ),.n(\0 ));
vcvs     #(.gain( 8.)) e1 (.p(\2 ),.n(\0 ),.ps(\1 ),.ns(\0 ));
resistor #(.r( 10.)) re1 (.p(\2 ),.n(\0 ));
//* sense the voltage source (0 volts) 
spice
i2 3 0 dc 11 ac 11
.verilog
//isource #( DC  11.  AC  11.) i2 (.p(\3 ),.n(\0 ));
resistor #(.r( 10.)) ri2 (.p(\4 ),.n(\0 ));
vsource  #(.dc( 0.)) v2 (.p(\3 ),.n(\4 ));
cccs     #(.gain( 8.)) f2 (.sink(\5 ),.src(\0 ),.in(v2));
resistor #(.r( 10.)) rf2 (.p(\5 ),.n(\0 ));
//* sense a live voltage source 
spice
v7 6 0 dc 11 ac 11
.verilog
//vsource #(.ac(11.), .dc(11.)) v7 (.p(\6 ),.n(\0 ));
resistor #(.r( 10.))   rv7 (.p(\6 ),.n(\0 ));
cccs     #(.gain( 8.)) f7  (.sink(\7 ),.src(\0 ),.in(v7));
resistor #(.r( 10.))   rf7 (.p(\7 ),.n(\0 ));

list
width out=132
print op v(1) v(2) v(3) v(4) v(5) v(6) v(7) f(f2) f(f7)
op
print tran v(1) v(2) v(3) v(4) v(5) v(6) v(7) f(f2) f(f7)
tran .05 .1 0
print ac v(1) v(2) v(3) v(4) v(5) v(6) v(7) f(f2) f(f7)
ac oct 1 1k 2k
end
