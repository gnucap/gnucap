* Felix Salfelder 2020
* GPLv3+

* bug? not used in measure or eval output
options numdgt=5
parameter pi=3.141592653589793

spice
V1 1 0 sin f={1./2./pi}
.verilog

store tran v(1)
print tran v(1)

parameter xx = .4

dc > /dev/null
print tran v(1)
tran {pi/2.}
measure v00 at(probe='v(1)' x=xx, order=0)
measure v01 at(probe='v(1)' x=xx, order=1)
measure v02 at(probe='v(1)' x=xx, order=2)
measure v03 at(probe='v(1)' x=xx, order=3)
measure v04 at(probe='v(1)' x=xx, order=4)
eval abs(v00 - sin(xx))
eval abs(v01 - sin(xx))
eval abs(v02 - sin(xx))
eval abs(v03 - sin(xx))
eval abs(v04 - sin(xx))

options trtol=1
dc > /dev/null
tran {pi/2.} > /dev/null
measure v10 at(probe='v(1)' x=xx, order=0)
measure v11 at(probe='v(1)' x=xx, order=1)
measure v12 at(probe='v(1)' x=xx, order=2)
measure v13 at(probe='v(1)' x=xx, order=3)
measure v14 at(probe='v(1)' x=xx, order=4)
eval abs(v10 - sin(xx))
eval abs(v11 - sin(xx))
eval abs(v12 - sin(xx))
eval abs(v13 - sin(xx))
eval abs(v14 - sin(xx))

options trtol=.1
dc > /dev/null
tran {pi/2.} > /dev/null
measure v21 at(probe='v(1)' x=xx)
measure v20 at(probe='v(1)' x=xx, order=0)
measure v21 at(probe='v(1)' x=xx, order=1)
measure v22 at(probe='v(1)' x=xx, order=2)
measure v23 at(probe='v(1)' x=xx, order=3)
measure v24 at(probe='v(1)' x=xx, order=4)
eval abs(v20 - sin(xx))
eval abs(v21 - sin(xx))
eval abs(v22 - sin(xx))
eval abs(v23 - sin(xx))
eval abs(v24 - sin(xx))

options trtol=.01
dc > /dev/null
tran {pi/2.} > /dev/null
measure v30 at(probe='v(1)' x=xx, order=0)
measure v31 at(probe='v(1)' x=xx, order=1)
measure v32 at(probe='v(1)' x=xx, order=2)
measure v33 at(probe='v(1)' x=xx, order=3)
measure v34 at(probe='v(1)' x=xx, order=4)
eval abs(v30 - sin(xx))
eval abs(v31 - sin(xx))
eval abs(v32 - sin(xx))
eval abs(v33 - sin(xx))
eval abs(v34 - sin(xx))
