
verilog

resistor #(.r(1))     Rin2 (\a , \b );
resistor #(.r(1))     Rin2 (\a , \b	); // tab
resistor #(.r(1))     Rin2 (\a*a , \-- );
resistor #(.r(1))     Rin2 (\$aa , \\\ );

module test();
  parameter real x = 1;
  parameter real y = \x + 1.;
  resistor #(.r(\x )) r1(a, b);
  resistor #(.r(\y:1 + 2.)) r1(a, b);
endmodule

