m #() mm(.a(\1 ), .b(\0 ));
                  ^ ? mm: mismatch b ignored
m #() mm(.x(\1 ), .d(\0 ));
         ^ ? mm: mismatch x ignored
module m (.a(a),.d(d));
  resistor #(.r(1)) r0 (.p(a),.n(b));
  resistor #(.r(1)) r1 (.p(b),.n(c));
  resistor #(.r(1)) r2 (.p(c),.n(d));
endmodule // m

m #() mm (.a(\1 ));
m #() mm (.d(\0 ));
