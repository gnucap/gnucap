module rr (.a(a),.b(b),.c(c),.ref(ref));
  parameter p=1;
  resistor #(.r($temperature())) r (.p(a),.n(ref));
  resistor #(.r($temperature)) r (.p(b),.n(ref));
  resistor #(.r($vt())) r (.p(c),.n(ref));
endmodule // rr

ground gnd;
isource #(.dc(1)) v1 (.p(\0 ),.n(\1 ));
isource #(.dc(1)) v2 (.p(\0 ),.n(\2 ));
isource #(.dc(1)) v3 (.p(\0 ),.n(\3 ));
rr #(.$dtemp(0.)) s (.a(\1 ),.b(\2 ),.c(\3 ),.ref(gnd));
