paramset logic logic;
 .delay=.1n; .vmax=5.; .vmin=0.; .unknown=NA( 2.5); .rise=1n; .fall=1n; .rs=100.; .rw=1.G; .thh=0.75; .thl=0.25; .mr=5.; .mf=5.; .over=10k; .tnom=NA( 27.);
endparamset

module chain (.out(out),.in(in));
  inv #(.delay(500)) b0 (.out(out),.in1(l3));
  inv #(.delay(400)) b1 (.out(l3),.in1(l2));
  inv #(.delay(500)) b2 (.out(l2),.in1(l1));
  inv #(.delay(400)) b3 (.out(l1),.in1(in));
endmodule // chain

module clock (.out(ii),.en(en));
  nand #(.delay(1000)) i0 (.out(ii),.in1(ii),.in2(en));
endmodule // clock

module main (.cc(cc),.en(en),.clk(clk),.out(out));
  ground gnd;
  chain #() t1 (.out(out),.in(clk));
  clock #() c1 (.out(clk),.en(en));
  resistor #(.r(100)) r1 (.p(out),.n(cc));
  capacitor #(.c(10p),.$method("trap")) c1 (.p(gnd),.n(cc));
endmodule // main

