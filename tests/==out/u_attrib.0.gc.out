"verilog "
"module aaa (c,d);"
"parameter y,x,a,b;"
"endmodule;"
""
"module bbb (e,f);"
"aaa #((*x*).x(1), (*a*).a(2), (*b*).b(3), (*y*).y(4)) a1(a,b);"
"endmodule;"
" "
"list"
module aaa (.c(c),.d(d));
endmodule // aaa

module bbb (.e(e),.f(f));
  aaa #((* x *) .x(1),(* a *) .a(2),(* b *) .b(3),(* y *) .y(4)) a1 (.c(a),.d(b));
endmodule // bbb

