spice

.subckt transformer (p1 p2 s1 s2)
L1 (p1 p2) 1
L2 (s1 s2) .1
K1 (L1 L2) .9
.ends

.model 1n4004 d is=1n cjo=1p

.subckt bridge (in1 in2 minus plus)
D1 (in1 plus) 1n4004
D2 (in2 plus) 1n4004
D3 (minus in1) 1n4004
D4 (minus in2) 1n4004
.ends

Rload (out 0) rload
Cfilter (out 0) cfilter $method={"trap"}

X1 (in 0 s1 s2) transformer $method={"trap"}
X2 (s1 s2 0 out) bridge $method={"euler"}
Vin (in 0) sin (freq=60 ampl=170) ac 120

R1 s1 0 10k
R2 s2 0 10k

.control

param cfilter 5000u
param rload 100

print dc method(Cfilter) method(X1.*) method(X*.D*.C*)
print tran v(nodes) P(Rload) control(0)

dc
print dc clear
tr .3

store tran v(out)
tran .4 trace=a

measure min=min("v(out)")
measure max=max("v(out)")

param range = max-min
eval range
measure mean=mean("v(out)")

status notime
